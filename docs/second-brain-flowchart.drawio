id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="apply" target="show"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="show" target="choose"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="choose" target="talk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="Mark done instead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="choose" target="finish"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="48" y="945"/><mxPoint x="48" y="1325"/></Array></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="dated" target="open"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="open" target="missed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="open" target="nudge"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1042" y="565"/><mxPoint x="1042" y="945"/></Array></mxGeometry></mxCell><mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="nudge" target="tap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="tap" target="once"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="busy" target="clear"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="clear" target="confirm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="confirm" target="gone"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="gone" target="keep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="keep" target="fresh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><object id="propose" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;AI suggests a follow-up&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;A conversation can propose something to revisit, with a title and an optional date.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 05 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-05"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="296" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="apply" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Apply the suggestion&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Choose Add to my workspace to save the check-in.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="show" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;See A gentle check-in on Today&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Loaded unfinished check-ins are shown here. They are not held back until their optional date.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="choose" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Want to discuss it?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1CD;strokeColor=#CEAE64;strokeWidth=1;align=center;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="120" y="866" width="340" height="158" as="geometry"/></mxCell><mxCell id="talk" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open its conversation draft&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Tap the check-in, review the draft, then Send. Unfinished check-ins can inform later AI replies.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="finish" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Or mark the check-in complete&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Use its check control. It leaves the unfinished check-in list.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1246" width="460" height="158" as="geometry"/></mxCell><mxCell id="dated" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;An unfinished task has a due time&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The reminder needs a date and time. Completed and undated items do not trigger it.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="open" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;App open near that time?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1CD;strokeColor=#CEAE64;strokeWidth=1;align=center;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="630" y="486" width="340" height="158" as="geometry"/></mxCell><mxCell id="missed" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Closed or missed the window&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;There is no background phone alert or later catch-up reminder in the current app.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="nudge" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;A gentle reminder appears&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The open app checks about every 30 seconds, for tasks less than 2 minutes past their due time.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="tap" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose Open task&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The short on-screen message opens the task editor so you can act on it or change the plan.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="once" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Avoid repeated nudges&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Each task and due-time pair is reminded once per open session. The message lasts about 15 seconds.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1246" width="460" height="158" as="geometry"/></mxCell><mxCell id="busy" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Wait for any current operation&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Sending and clearing are disabled while a reply or clearing operation is in progress. A clear request is not queued.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="clear" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose how to clear the chat&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Use the assistant’s Clear control, or send exactly clear or /clear.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="confirm" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Button: confirm with another click&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Click again within 3.5 seconds. Sending clear or /clear clears immediately, without this extra confirmation.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="gone" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;The conversation is removed&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;All saved chat messages and unapplied proposals are deleted, including older hidden messages.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEDE9;strokeColor=#D2A69B;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="keep" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Your workspace stays&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Tasks, journal, profile, check-ins, Gemini connection and changes already applied from chat all remain.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="fresh" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Start a fresh conversation&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The assistant can still use the workspace information that remains. Clear chat is not a full memory reset.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1246" width="460" height="158" as="geometry"/></mxCell><object id="home" label="← Overview / choose another page" link="data:page/id,page-01"><mxCell style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#2B6752;" vertex="1" parent="1"><mxGeometry x="60" y="1519" width="900" height="30" as="geometry"/></mxCell></object><mxCell id="number" value="SECOND BRAIN  ·  06 / 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#64796F;" vertex="1" parent="1"><mxGeometry x="1230" y="1519" width="310" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-07" name="07 Settings &amp; Gemini"><mxGraphModel dx="1600" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1560" background="#F7F8F4" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Settings &amp; your Gemini key&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=38;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="1460" height="60" as="geometry"/></mxCell><mxCell id="sub" value="Personalize your planner and connect AI from inside the app." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=18;fontColor=#526960;" vertex="1" parent="1"><mxGeometry x="60" y="108" width="1470" height="48" as="geometry"/></mxCell><mxCell id="eyebrow" value="SECOND BRAIN / APP WALKTHROUGH / 07 OF 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#5F7B70;" vertex="1" parent="1"><mxGeometry x="60" y="174" width="1460" height="27" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="42" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText0" value="&lt;b&gt;Your profile&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="552" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText1" value="&lt;b&gt;Connect or replace Gemini&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1062" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText2" value="&lt;b&gt;Manage the connection&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="settings" target="about"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="about" target="zone"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="zone" target="save"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="save" target="personal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="get" target="enter"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="enter" target="check"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="check" target="valid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="valid" target="fail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="valid" target="ok"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="558" y="945"/><mxPoint x="558" y="1325"/></Array></mxGeometry></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="stored" target="use"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="use" target="disconnect"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="disconnect" target="manual"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="manual" target="reconnect"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="settings" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open Settings&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Use your profile area on desktop or the Settings button on mobile.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="about" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Tell it about yourself&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Set your name, role or what you do, school/work context and goals.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="zone" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose a planning timezone&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;This decides what counts as today and how the app displays and groups dated tasks.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="save" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Save your profile&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Success confirms the update. If it fails, the form shows an error so you can correct it.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="personal" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;More personal planning&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Your saved profile becomes context for future Gemini requests. Conversation can also propose profile updates.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="onboard" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;First-time setup&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The web app invites you to make the space yours. Android starts with a local “My Space” profile and device timezone.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1246" width="460" height="158" as="geometry"/></mxCell><mxCell id="get" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open the Gemini connection area&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Use Get a key to visit Google AI Studio if needed. Return to Settings with your own key.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="enter" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Enter the key in the app&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The input hides its characters. Choose Connect, or Replace if a key is already connected.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="check" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;The app checks it with Google&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Internet is needed to validate the key.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="valid" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Was the key accepted?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1CD;strokeColor=#CEAE64;strokeWidth=1;align=center;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="630" y="866" width="340" height="158" as="geometry"/></mxCell><mxCell id="fail" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Connection failed&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Read the error and correct the key or connection. A failed replacement leaves the previous saved key intact.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEDE9;strokeColor=#D2A69B;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1056" width="460" height="158" as="geometry"/></mxCell><object id="ok" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Gemini connected&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The assistant becomes available. The saved key is not shown back to you in the settings form.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 05 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-05"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1246" width="460" height="158" as="geometry"/></mxCell></object><object id="stored" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Where is the key kept?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Web: encrypted on the server. Android: private app storage on this phone; the current code does not encrypt it.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 08 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-08"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="296" width="460" height="158" as="geometry"/></mxCell></object><object id="use" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Use AI when you choose&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Sending a message shares selected workspace context with Google to prepare the reply.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 08 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-08"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="486" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="disconnect" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose Disconnect&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Removes the saved Gemini key for this workspace.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="manual" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Everyday planning still works&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Your tasks, journal, saved chat, profile and check-ins remain. New AI replies require reconnecting.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="reconnect" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Connect again later&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Repeat the connection steps with a valid key when you want AI help again.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="account" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Leaving the app&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Web provides Sign out. Android uses its local workspace and has no account sign-in flow in the current app.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1246" width="460" height="158" as="geometry"/></mxCell><object id="home" label="← Overview / choose another page" link="data:page/id,page-01"><mxCell style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#2B6752;" vertex="1" parent="1"><mxGeometry x="60" y="1519" width="900" height="30" as="geometry"/></mxCell></object><mxCell id="number" value="SECOND BRAIN  ·  07 / 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#64796F;" vertex="1" parent="1"><mxGeometry x="1230" y="1519" width="310" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-08" name="08 Web, Android &amp; recovery"><mxGraphModel dx="1600" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1560" background="#F7F8F4" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Web, Android &amp; everyday recovery&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=38;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="1460" height="60" as="geometry"/></mxCell><mxCell id="sub" value="The same planning experience, with important differences in where your information lives." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=18;fontColor=#526960;" vertex="1" parent="1"><mxGeometry x="60" y="108" width="1470" height="48" as="geometry"/></mxCell><mxCell id="eyebrow" value="SECOND BRAIN / APP WALKTHROUGH / 08 OF 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#5F7B70;" vertex="1" parent="1"><mxGeometry x="60" y="174" width="1460" height="27" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="42" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText0" value="&lt;b&gt;Web / your online workspace&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="552" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText1" value="&lt;b&gt;Android / this phone&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1062" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText2" value="&lt;b&gt;Helpful controls &amp; recovery&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="account" target="online"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="online" target="key"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="key" target="context"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="context" target="history"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="history" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="local" target="offline"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="offline" target="separate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="separate" target="google"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="google" target="failure"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="failure" target="back"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="load" target="forms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="short" target="access"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="access" target="motion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="account" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open your signed-in web space&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Your profile and records belong to your account.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="online" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Internet is needed for saved work&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The browser reads and saves through the online app. Tasks, journal, chats and check-ins stay in that workspace.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="key" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Your Gemini key stays server-side&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The web app stores it encrypted and uses it on the server to contact Google. The browser does not call Gemini directly.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="context" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;What goes to Gemini when you send?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Profile and current time; up to 75 selected tasks, 5 recent thoughts, 12 recent messages and 20 unfinished check-ins.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="history" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;How much history is shown?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The workspace loads all tasks, the latest 100 journal entries and 40 chat messages. Older saved history is not all displayed.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="out" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Sign out when finished&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Your online records remain attached to your account. Clearing chat is a separate action.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1246" width="460" height="158" as="geometry"/></mxCell><mxCell id="local" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open the installed Android app&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;It starts with a local workspace. No mandatory sign-in is implemented.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="offline" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Plan even without internet&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Read and manage local tasks, thoughts and check-ins. These records are saved on the phone.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="separate" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Phone and web are separate&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The current app has no phone-to-web synchronization. Do not expect edits to appear automatically on both.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="google" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;AI still needs internet&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Android contacts Google directly using the key saved in private app preferences. That key is not encrypted by the current code.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="failure" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;If an AI request fails&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Your Android chat can retain the sent message without a reply. There is no queued offline send or automatic retry.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="back" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Android Back and outside links&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Back uses browser history when available, otherwise exits. Outside links open another app or browser when possible.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1246" width="460" height="158" as="geometry"/></mxCell><mxCell id="load" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Loading → ready, or Retry&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Loading placeholders appear first. A workspace error gives you a Retry action. Empty views explain the next useful step.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="forms" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Saving → confirmation, or correction&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Forms show progress and disable repeat submits. Errors keep the form and input available; success refreshes the relevant lists.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="short" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Keyboard shortcuts&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Ctrl / Cmd + K: Find. N: Add task when not typing. In chat, Enter sends and Shift + Enter adds a line.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="access" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Use keyboard or touch&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Status tabs support arrow keys and Home / End. Labelled controls, focus handling, announced states and Skip to tasks help navigation.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="motion" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Small, purposeful transitions&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The interface adapts for mobile, tablet and desktop, with reduced-motion support. Dialogs keep editors focused.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="scope" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;About this map&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Based on the app’s current source, including the Android and clear-chat additions. Created 17 September 2026. No app tests were run.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1246" width="460" height="158" as="geometry"/></mxCell><object id="home" label="← Overview / choose another page" link="data:page/id,page-01"><mxCell style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#2B6752;" vertex="1" parent="1"><mxGeometry x="60" y="1519" width="900" height="30" as="geometry"/></mxCell></object><mxCell id="number" value="SECOND BRAIN  ·  08 / 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#64796F;" vertex="1" parent="1"><mxGeometry x="1230" y="1519" width="310" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>