;&lt;span style=&quot;font-size:15px&quot;&gt;Use the web app or the installed Android app. Your main screen is Today.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="load" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Your workspace loads&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;See your saved tasks, journal, conversations and check-ins.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="ready" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Did it load?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1CD;strokeColor=#CEAE64;strokeWidth=1;align=center;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="120" y="676" width="340" height="158" as="geometry"/></mxCell><object id="retry" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Something went wrong&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Read the message, then choose Retry. Your saved work is not intentionally cleared.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 08 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-08"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEDE9;strokeColor=#D2A69B;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="866" width="460" height="158" as="geometry"/></mxCell></object><object id="home" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Today is your starting point&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Check today’s plan, older unfinished tasks, upcoming events and gentle check-ins.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 03 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-03"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7EFED;strokeColor=#85A79A;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1056" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="new" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;New here? Start small&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Add one task or open Settings to tell the app about yourself. An empty space has helpful prompts.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1246" width="460" height="158" as="geometry"/></mxCell><object id="tasks" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;02 · Tasks &amp;amp; events&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Capture something, set a date, edit the plan, complete it or undo.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 02 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-02"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7EFED;strokeColor=#85A79A;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="296" width="460" height="158" as="geometry"/></mxCell></object><object id="dates" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;03 · Today, Upcoming &amp;amp; Find&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Choose a view, filter your list, search tasks and see what comes next.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 03 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-03"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7EFED;strokeColor=#85A79A;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="486" width="460" height="158" as="geometry"/></mxCell></object><object id="journal" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;04 · Journal&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Save a thought in your own words, edit it later or ask for reflection.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 04 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-04"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7EFED;strokeColor=#85A79A;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="676" width="460" height="158" as="geometry"/></mxCell></object><object id="brain" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;05 · Your second brain&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Ask Gemini to help plan, clarify or break things into manageable steps. Review proposed changes.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 05 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-05"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7EFED;strokeColor=#85A79A;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="866" width="460" height="158" as="geometry"/></mxCell></object><object id="gentle" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;06 · Gentle nudges &amp;amp; a fresh chat&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Follow up, see reminders while the app is open, or clear the conversation.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 06 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-06"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7EFED;strokeColor=#85A79A;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1056" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="nav" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Move between sections&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Desktop: sidebar. Mobile: bottom navigation and central Add button. Search, AI and Settings stay within reach.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1246" width="460" height="158" as="geometry"/></mxCell><object id="profile" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;07 · Personalize your 