 x="1080" y="676" width="460" height="158" as="geometry"/></mxCell></object><object id="control" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;You decide what changes&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;AI replies can propose changes. They are saved to your workspace only when you apply them.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 05 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-05"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="866" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="save" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Return to your saved work&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Tasks, thoughts, applied suggestions and conversations remain in their platform’s workspace.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="read" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;How to read this map&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Arrows show the next step. Gold diamonds are decisions. Purple boxes involve AI. Numbered cards open detail pages.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry 