"topic" target="draft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="draft" target="send"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="context" target="google"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="google" target="clarify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="clarify" target="reply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="reply" target="continue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="Error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="google" target="error"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1042" y="565"/><mxPoint x="1042" y="1325"/></Array></mxGeometry></mxCell><mxCell id="edge11" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="proposal" target="advice"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="proposal" target="review"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1068" y="375"/><mxPoint x="1068" y="755"/></Array></mxGeometry></mxCell><mxCell id="edge13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="review" target="apply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="apply" target="saved"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="saved" target="control"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="send" target="context"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="1325"/><mxPoint x="545" y="287"/><mxPoint x="800" y="287"/></Array></mxGeometry></mxCell><mxCell id="edge17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="reply" target="proposal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1055" y="945"/><mxPoint x="1055" y="287"/><mxPoint x="1310" y="287"/></Array></mxGeometry></mxCell><mxCell id="open" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open the assistant&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Wide desktop: side panel. Smaller screens: popup. Closing it keeps your conversation and unsent draft.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="key" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Gemini connected?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1CD;strokeColor=#CEAE64;strokeWidth=1;align=center;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="120" y="486" width="340" height="158" as="geometry"/></mxCell><object id="connect" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Connect it in Settings&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Enter your key inside the app, then come back. The send button stays unavailable until connected.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 07 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-07"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7EFED;strokeColor=#85A79A;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="topic" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose a starting point&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Plan my day, prepare for a test, make sense of a brain dump, reflect on a thought, or follow up.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="draft" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Review or write your message&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Starter buttons fill a draft. Add your own words. The assistant can ask one question at a time.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="send" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Send when ready&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Enter sends; Shift + Enter adds a line. Wait while your brain is thinking.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1246" width="460" height="158" as="geometry"/></mxCell><object id="context" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;The app adds selected context&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Your profile, current time, relevant tasks, recent thoughts, recent chat and unfinished check-ins.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 08 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-08"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="296" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="google" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Gemini considers your request&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;It can help prioritize, break down preparation, sort thoughts, personalize your plan or suggest a check-in.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="clarify" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Something unclear?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The assistant is instructed to ask about unclear dates and missing details instead of inventing them.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="reply" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Read the reply&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;A reply may be advice only, a follow-up question, or advice plus proposed workspace changes.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="continue" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Continue the conversation&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Answer its question or ask for a smaller step. Saved conversation history is available when you return.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="error" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;No usable reply?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Read the error. Check internet or Gemini settings, then retry. Failed sends keep your text available to try again.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEDE9;strokeColor=#D2A69B;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1246" width="460" height="158" as="geometry"/></mxCell><mxCell id="proposal" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Does the reply propose changes?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1CD;strokeColor=#CEAE64;strokeWidth=1;align=center;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1140" y="296" width="340" height="158" as="geometry"/></mxCell><mxCell id="advice" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Advice only&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Read it or keep chatting. Your tasks and journal are unchanged by the reply itself.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="review" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Review the proposed set&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Possible changes: add tasks/events, save a journal thought/summary, update your profile, add check-ins.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="apply" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose Add to my workspace&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Apply the whole set shown for that message. There is no per-item selection in the current app.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="saved" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Added to your workspace&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Your lists refresh and the message shows it was applied. Applying the same message again does not add duplicates.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="control" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;You remain in control&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Leaving a proposal unapplied saves no proposed changes. AI does not silently delete or complete your tasks.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1246" width="460" height="158" as="geometry"/></mxCell><object id="home" label="← Overview / choose another page" link="data:page/id,page-01"><mxCell style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#2B6752;" vertex="1" parent="1"><mxGeometry x="60" y="1519" width="900" height="30" as="geometry"/></mxCell></object><mxCell id="number" value="SECOND BRAIN  ·  05 / 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#64796F;" vertex="1" parent="1"><mxGeometry x="1230" y="1519" width="310" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-06" name="06 Check-ins, reminders &amp; clear"><mxGraphModel dx="1600" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1560" background="#F7F8F4" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Gentle check-ins, reminders &amp; a fresh chat&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=38;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="1460" height="60" as="geometry"/></mxCell><mxCell id="sub" value="Three different kinds of support: a saved follow-up, a timely nudge, or a clean conversation." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=18;fontColor=#526960;" vertex="1" parent="1"><mxGeometry x="60" y="108" width="1470" height="48" as="geometry"/></mxCell><mxCell id="eyebrow" value="SECOND BRAIN / APP WALKTHROUGH / 06 OF 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;