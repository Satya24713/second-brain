gonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="keep" target="cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="keep" target="saveedit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="Error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="saveedit" target="failure"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="Saved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="saveedit" target="updated"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1042" y="945"/><mxPoint x="1042" y="1325"/></Array></mxGeometry></mxCell><mxCell id="edge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="check" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="done" target="completed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="delete" target="confirm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="confirm" target="stay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge15" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="confirm" target="removed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="add" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose Add task&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Use the main Add button, the mobile + button, or the N shortcut when you are not typing.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="title" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Write what needs doing&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;A title is required. Add optional notes, a date and time, and a tag in your own words.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="kind" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose the kind and priority&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Task or Event / test. Normal or Important. Reuse a suggested tag or write a new one.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="dates" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Keep or change the date&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Adding from Today starts with a date. Elsewhere the date can stay empty. Check it before saving.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="save" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Save the task&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;While saving, wait for the result. If there is an error, your input stays in the editor so you can correct it.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1056" width="460" height="158" as="geometry"/></mxCell><object id="added" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Task added&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;A confirmation appears and the lists refresh. Its date decides whether it also appears in Today or Upcoming.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 03 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-03"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1246" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="open" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open a saved task&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Tap its title, its row or the edit arrow. Search results and upcoming cards open the same editor.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="edit" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Update the details&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Change the title, notes, tag, date, kind or priority as your plans change.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="keep" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Keep these changes?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1CD;strokeColor=#CEAE64;strokeWidth=1;align=center;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="630" y="676" width="340" height="158" as="geometry"/></mxCell><mxCell id="cancel" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Cancel&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Close without saving these edits.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="866" width="215" height="158" as="geometry"/></mxCell><mxCell id="saveedit" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Save changes&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Submit your updated plan.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="815" y="866" width="215" height="158" as="geometry"/></mxCell><mxCell id="failure" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;If saving fails&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The editor stays open with the error and your entered values. Fix the issue and try again.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEDE9;strokeColor=#D2A69B;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="updated" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Your plan is updated&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The refreshed lists reflect the changed date, priority, tag and details.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1246" width="460" height="158" as="geometry"/></mxCell><mxCell id="check" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Tick the completion circle&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;This completes an unfinished task. On a finished task, it reopens it.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="done" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;See the change and Undo&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;A success message offers Undo for completing or reopening. Switch status tabs to find the task.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="completed" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;To do ↔ Completed&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Completed items remain saved. Reopen one whenever it needs your attention again.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="delete" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;To remove it, open its editor&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Choose Delete. The button changes to Confirm delete.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="confirm" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Remove permanently?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1CD;strokeColor=#CEAE64;strokeWidth=1;align=center;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1140" y="1056" width="340" height="158" as="geometry"/></mxCell><mxCell id="stay" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Cancel&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Keep the task.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1246" width="215" height="158" as="geometry"/></mxCell><mxCell id="removed" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Confirm delete&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Task removed; this has no Undo.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEDE9;strokeColor=#D2A69B;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1325" y="1246" width="215" height="158" as="geometry"/></mxCell><object id="home" label="← Overview / choose another page" link="data:page/id,page-01"><mxCell style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#2B6752;" vertex="1" parent="1"><mxGeometry x="60" y="1519" width="900" height="30" as="geometry"/></mxCell></object><mxCell id="number" value="SECOND BRAIN  ·  02 / 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#64796F;" vertex="1" parent="1"><mxGeometry x="1230" y="1519" width="310" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-03" name="03 Today, Upcoming &amp; Find"><mxGraphModel dx="1600" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1560" background="#F7F8F4" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Today, Upcoming &amp; Find&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=38;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="1460" height="60" as="geometry"/></mxCell><mxCell id="sub" value="The same tasks can appear in different views. Dates and filters determine what you see." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=18;fontColor=#526960;" vertex="1" parent="1"><mxGeometry x="60" y="108" width="1470" height="48" as="geometry"/></mxCell><mxCell id="eyebrow" value="SECOND BRAIN / APP WALKTHROUGH / 03 OF 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#5F7B70;" vertex="1" parent="1"><mxGeometry x="60" y="174" width="1460" height="27" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="42" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText0" value="&lt;b&gt;Today / focus now&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="552" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText1" value="&lt;b&gt;Upcoming / look ahead&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1062" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText2" value="&lt;b&gt;All tasks / find anything&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="today" target="old"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="old" target="list"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="list" target="ring"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="ring" target="nudge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="nudge" target="next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="up" target="status"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="status" target="group"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="group" target="prep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="nodate" target="clock"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="all" target="filter"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="filter" target="find"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="find" target="results"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="No result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="find" target="none"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1552" y="755"/><mxPoint x="1552" y="1135"/></Array></mxGeometry></mxCell><mxCell id="edge13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="none" target="change"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="today" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open Today&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Choose To do for unfinished items, or Completed for finished items.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="old" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Needs a new plan&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Tasks dated before today appear here. Move their date, work on them, complete them or edit the details.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="list" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;On your list&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Tasks dated today appear here. “Today” follows your planning timezone.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="ring" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Today’s progress&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The pending count and progress ring count only tasks dated today. Older tasks are not included in that summary.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="866" width="460" height="158" as="geometry"/></mxCell><object id="nudge" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Need help starting?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;“Not sure where to start?” opens an AI draft. “A gentle check-in” opens a follow-up draft. You choose when to send.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 05 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-05"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1056" width="460" height="158" as="geometry"/></mxCell></object><object id="next" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Around the corner&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Shows up to 3 unfinished future events, or 2 unfinished future tasks if there are no events. Tap to edit, or open Upcoming.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 03 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-03"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7EFED;strokeColor=#85A79A;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1246" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="up" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open Upcoming&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Items dated after today are grouped by calendar day.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="status" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose To do or Completed&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;See unfinished future plans, or finished items whose dates are still in the future.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="group" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Browse the dated groups&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;See deadlines, tests and other plans with their dates. Open any row to change its details.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="676" width="460" height="158" as="geometry"/></mxCell><object id="prep" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Plan ahead with your brain&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Ask for help preparing for an event or test. The prompt opens as a draft for you to send.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 05 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-05"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="866" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="nodate" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;No due date?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;An undated task stays in All tasks. Give it a date when you want it in Today or Upcoming.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1056" width="460" height="158" as="geometry"/></mxCell><object id="clock" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Dates follow your timezone&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Enter dates using your device’s local time. The app groups and displays them using your profile’s planning timezone.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 07 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-07"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1246" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="all" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open All tasks&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;See dated and undated items. Switch between To do and Completed.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="filter" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Narrow or sort the list&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Filter by tag or search text. Sort by date, Important first, or newest. Undated items come last when sorting by date.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="find" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose Find anything&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Search task titles, task notes and tags, including events and completed tasks. Journal and chat are not searched.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="results" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose a matching task&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Up to 20 results appear. Choosing one opens its editor and clears the search.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="none" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;No match or an empty view?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Try different words or clear the filter. Closing Find without choosing a result keeps its text as a list filter.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="change" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Switch to another section&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The app clears tag/search filters and returns to To do. Your sort choice stays.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1246" width="460" height="158" as="geometry"/></mxCell><object id="home" label="← Overview / choose another page" link="data:page/id,page-01"><mxCell style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#2B6752;" vertex="1" parent="1"><mxGeometry x="60" y="1519" width="900" height="30" as="geometry"/></mxCell></object><mxCell id="number" value="SECOND BRAIN  ·  03 / 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#64796F;" vertex="1" parent="1"><mxGeometry x="1230" y="1519" width="310" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-04" name="04 Journal"><mxGraphModel dx="1600" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1560" background="#F7F8F4" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Journal&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=38;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="1460" height="60" as="geometry"/></mxCell><mxCell id="sub" value="Get thoughts out of your head, keep your own words, and ask for help when you want it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=18;fontColor=#526960;" vertex="1" parent="1"><mxGeometry x="60" y="108" width="1470" height="48" as="geometry"/></mxCell><mxCell id="eyebrow" value="SECOND BRAIN / APP WALKTHROUGH / 04 OF 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#5F7B70;" vertex="1" parent="1"><mxGeometry x="60" y="174" width="1460" height="27" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="42" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText0" value="&lt;b&gt;Capture &amp; revisit&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="552" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText1" value="&lt;b&gt;Edit or remove&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1062" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText2" value="&lt;b&gt;Reflect with your brain&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="open" target="write"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="write" target="save"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="save" target="saved"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="saved" target="read"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="Error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="save" target="error"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="48" y="755"/><mxPoint x="48" y="1325"/></Array></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="edit" target="update"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="update" target="updated"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="delete" target="confirm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="confirm" target="keep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="confirm" target="remove"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="reflect" target="draft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="draft" target="send"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="send" target="reply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="reply" target="suggest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#6E887D;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3A5B4D;fontSize=13;labelBackgroundColor=#F7F8F4;" edge="1" parent="1" source="suggest" target="choice"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="open" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open Journal&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Start with a freeform thought, a messy brain dump or something you want to remember.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="write" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Write in your own words&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Up to 12,000 characters. Blank-only entries cannot be saved.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="save" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose Save thought&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Your words are stored as a journal entry with a date and time.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="saved" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Thought saved&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;A success message appears. The saved entry joins your recent thoughts.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="read" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Revisit recent thoughts&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Browse the latest 100 entries. A thought may show an AI summary if one was saved with it.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1056" width="460" height="158" as="geometry"/></mxCell><mxCell id="error" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;If saving fails&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Read the error and retry. Your draft stays available.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEDE9;strokeColor=#D2A69B;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="1246" width="460" height="158" as="geometry"/></mxCell><mxCell id="edit" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Open an existing thought&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Choose Edit thought to open its editor.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="update" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Revise the words&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Change the entry and choose Save changes, or Cancel to leave the saved entry as it is.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="486" width="460" height="158" as="geometry"/></mxCell><mxCell id="updated" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Thought updated&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Web removes the old AI summary after an edit. Android currently keeps that summary, even when the words change.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="676" width="460" height="158" as="geometry"/></mxCell><mxCell id="delete" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Want to remove it?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Choose Delete in the editor.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBCDC5;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="866" width="460" height="158" as="geometry"/></mxCell><mxCell id="confirm" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Confirm deletion?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1CD;strokeColor=#CEAE64;strokeWidth=1;align=center;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="630" y="1056" width="340" height="158" as="geometry"/></mxCell><mxCell id="keep" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Cancel&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Keep the entry.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF1EF;strokeColor=#CCD6D0;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="1246" width="215" height="158" as="geometry"/></mxCell><mxCell id="remove" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Confirm delete&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Entry removed.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FCEDE9;strokeColor=#D2A69B;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="815" y="1246" width="215" height="158" as="geometry"/></mxCell><mxCell id="reflect" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose Reflect with my brain&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The app opens the assistant with a draft based on your thought. It does not send automatically.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="296" width="460" height="158" as="geometry"/></mxCell><mxCell id="draft" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Review the prepared message&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;It uses the first part of the entry, up to 5,000 characters, and asks for clarity and a next step.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="486" width="460" height="158" as="geometry"/></mxCell><object id="send" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose Send&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Gemini must be connected and internet must be available. Your context goes to Google for this request.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 07 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-07"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="676" width="460" height="158" as="geometry"/></mxCell></object><mxCell id="reply" value="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Read the reflection&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The prompt asks the assistant not to save a duplicate journal entry. The original thought stays in Journal.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="866" width="460" height="158" as="geometry"/></mxCell><object id="suggest" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Review any suggested actions&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;A reply can propose tasks or another helpful change. Read all the proposals before applying them.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 05 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-05"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0ECF9;strokeColor=#B4A4D3;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1056" width="460" height="158" as="geometry"/></mxCell></object><object id="choice" label="&lt;div style=&quot;font-family:Arial;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Choose what to do next&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Keep chatting, leave suggestions unapplied, or apply the whole proposed set to your workspace.&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#526960&quot;&gt;OPEN PAGE 05 &amp;#8594;&lt;/span&gt;&lt;/div&gt;" link="data:page/id,page-05"><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F3EB;strokeColor=#84AF96;strokeWidth=1;align=left;verticalAlign=middle;spacing=16;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="1080" y="1246" width="460" height="158" as="geometry"/></mxCell></object><object id="home" label="← Overview / choose another page" link="data:page/id,page-01"><mxCell style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=14;fontColor=#2B6752;" vertex="1" parent="1"><mxGeometry x="60" y="1519" width="900" height="30" as="geometry"/></mxCell></object><mxCell id="number" value="SECOND BRAIN  ·  04 / 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#64796F;" vertex="1" parent="1"><mxGeometry x="1230" y="1519" width="310" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-05" name="05 Your second brain"><mxGraphModel dx="1600" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1560" background="#F7F8F4" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Your second brain&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=38;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="1460" height="60" as="geometry"/></mxCell><mxCell id="sub" value="A conversation that understands your workspace and offers changes for you to review." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=18;fontColor=#526960;" vertex="1" parent="1"><mxGeometry x="60" y="108" width="1470" height="48" as="geometry"/></mxCell><mxCell id="eyebrow" value="SECOND BRAIN / APP WALKTHROUGH / 05 OF 08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#5F7B70;" vertex="1" parent="1"><mxGeometry x="60" y="174" width="1460" height="27" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="42" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText0" value="&lt;b&gt;Start a conversation&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="60" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="552" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText1" value="&lt;b&gt;Get a useful reply&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=20;fontColor=#173E36;" vertex="1" parent="1"><mxGeometry x="570" y="243" width="460" height="38" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=1;arcSize=3;fillColor=#EAF0EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1062" y="228" width="496" height="1292" as="geometry"/></mxCell><mxCell id="laneText2" value="&lt;b&gt;Turn suggestions into action&lt;/b&gt;" styl